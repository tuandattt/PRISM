# ---------------------------------------------------------------------------
# LLM backend: a local vLLM server. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- local vLLM: CUDA_VISIBLE_DEVICES=0 vllm serve Qwen/Qwen2.5-7B-Instruct --port 8000 ---
BASE_URL = "http://localhost:8000/v1"
API_KEY  = "EMPTY"

# --- client behaviour ---
# Number of parallel requests sent to the LLM server.
LLM_MAX_CONCURRENCY = 32
LLM_TIMEOUT = 180
LLM_MAX_RETRIES = 5

# NOTE: HF_HOME does NOT belong here -- huggingface_hub reads it at import time,
# before this file is necessarily loaded. Export it in your shell instead:
#   export HF_HOME=/path/with/space/.cache/huggingface

# --- optional path overrides (default: <repo>/data and <repo>/output) ---
# ARG_DATA_ROOT = ""
# ARG_OUTPUT_ROOT = ""
